{
  "name": "complianceguard-desktop",
  "version": "4.0.0",
  "description": "ComplianceGuard - SOC 2 Automation Desktop Application",
  "main": "electron/main.js",
  "author": "Egyan07",
  "license": "BSL-1.1",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "cd frontend && npm run build",
    "package": "npm run build && electron-builder --win --x64 --publish never",
    "publish": "npm run build && electron-builder --win --x64 --publish always",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "publish:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish always",
    "package:all": "npm run build && electron-builder --win --x64 --linux --mac --publish never",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test:scheduler": "npx vitest run --config vitest.config.electron.cjs",
    "pretest:scheduler": "npm rebuild better-sqlite3",
    "check:package-secrets": "node scripts/check-package-secrets.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^8.2.2",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.5",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.complianceguard.desktop",
    "productName": "ComplianceGuard",
    "copyright": "Copyright © 2026 Egyan07",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "shared/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.p12",
      "!**/*.pfx",
      "!electron/**/*.test.js",
      "!electron/licensing/generate-key.js"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": true
    },
    "msi": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Egyan07",
      "repo": "ComplianceGuard",
      "releaseType": "draft"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/icon.png",
      "category": "Utility",
      "maintainer": "Egyan07 <alexisegyan1232@gmail.com>",
      "synopsis": "ComplianceGuard — endpoint evidence collection and compliance scoring"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}_${version}_${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "gatekeeperAssess": false
    }
  }
}

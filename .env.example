[TEMPLATE]
# ComplianceGuard SOC 2 Automation Platform - Environment Variables
# Copy this file to .env and customize for your environment
#
# Every variable below is actually read by the backend (pydantic-settings
# field), the frontend (import.meta.env.VITE_*), docker-compose, or a
# scripts/*.sh helper. `scripts/check-env-example.py` enforces this at CI
# time, so obsolete entries cannot silently return.

# ===========================================================================
# Database Configuration
# ===========================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://complianceguard:complianceguard@localhost:5432/complianceguard

# Database credentials (used by docker-compose and scripts/db-*.sh)
DB_USER=complianceguard
DB_PASSWORD=complianceguard
DB_NAME=complianceguard


# ===========================================================================
# Security Configuration
# ===========================================================================

# Secret key for JWT token signing (master secret)
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# Domain-separated cryptographic keys (optional, recommended for production).
# Each, when set, replaces SECRET_KEY for a single domain so a compromise or
# rotation of one key does not affect the others:
#   JWT_SECRET                  -> access/refresh token signing
#   CREDENTIAL_ENCRYPTION_KEY   -> at-rest encryption of AWS credentials
#   AUDIT_HMAC_KEY              -> tamper-evident audit-log hash chain
# Migration note: unset keys fall back to SECRET_KEY, so existing data
# (issued JWTs, stored credentials, audit chains) keeps working unchanged.
# AUDIT_HMAC_KEY changes the chain key — only introduce it on a fresh
# deployment or when the audit chain is intentionally re-anchored.
#JWT_SECRET=
#CREDENTIAL_ENCRYPTION_KEY=
#AUDIT_HMAC_KEY=

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Password hashing
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_UPPERCASE=true


# ===========================================================================
# AWS Integration (for evidence collection)
# ===========================================================================

# AWS credentials for evidence collection
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# S3 bucket for evidence storage (optional)
AWS_S3_BUCKET=complianceguard-evidence


# ===========================================================================
# Application Configuration
# ===========================================================================

# Environment mode
ENVIRONMENT=development  # development, staging, production

# Enterprise mode — set to true for air-gapped Enterprise deployments.
# Disables Sentry telemetry entirely. Use docker-compose.enterprise.yml instead
# of this file for full Enterprise air-gapped deployment.
ENTERPRISE_MODE=false

# Debug settings
DEBUG=true
LOG_LEVEL=info  # debug, info, warning, error
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# API Configuration
API_V1_PREFIX=/api/v1

# Server Configuration
WORKERS=1

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://yourdomain.com"]

# Rate limiting — shared-storage URI enables limits across workers
# (redis://... for multi-worker deployments; in-memory when unset)
#RATELIMIT_STORAGE_URI=redis://redis:6379/0


# ===========================================================================
# Frontend Configuration
# ===========================================================================

# API base URL for frontend (docker-compose consumes these too)
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=ComplianceGuard SOC 2 Platform

# Sentry error monitoring (optional - no-op when unset)
VITE_SENTRY_DSN=


# ===========================================================================
# Email Configuration
# ===========================================================================

# Set EMAIL_ENABLED=true and configure SMTP_* to send real emails.
# When EMAIL_ENABLED=false (default), verification/reset tokens are logged but not sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@complianceguard.com
SMTP_FROM_NAME=ComplianceGuard
SMTP_TLS=true
SMTP_SSL=false
EMAIL_ENABLED=false
APP_BASE_URL=https://yourdomain.com


# ===========================================================================
# Error Monitoring
# ===========================================================================

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1


# ===========================================================================
# File Storage
# ===========================================================================

# Local file storage root for uploaded evidence
EVIDENCE_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,json,csv

# Evidence retention
EVIDENCE_RETENTION_DAYS=2555  # 7 years for compliance


# ===========================================================================
# Testing Configuration (for development)
# ===========================================================================

# Test database
TEST_DATABASE_URL=sqlite:///test_complianceguard.db


# ===========================================================================
# Advanced Configuration
# ===========================================================================

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ===========================================================================
# Production Security Recommendations
# ===========================================================================

# Uncomment and set in production:

# # Stronger secret key
# SECRET_KEY=$(openssl rand -hex 32)

# # Disable debug in production
# DEBUG=false
# ENVIRONMENT=production

# # Secure CORS
# CORS_ORIGINS=["https://yourdomain.com"]

# # Shared-storage rate limiting for multi-worker deployments
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# # Enable monitoring
# SENTRY_DSN=your-sentry-dsn

# # Secure email
# SMTP_HOST=your-smtp-server
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# # Enable advanced security features
# PASSWORD_MIN_LENGTH=12
# PASSWORD_REQUIRE_SPECIAL=true
# PASSWORD_REQUIRE_DIGITS=true
# PASSWORD_REQUIRE_UPPERCASE=true

# ===========================================================================
# Usage Instructions
# ===========================================================================

# 1. Copy this file to .env in the project root:
#    cp .env.example .env

# 2. Edit the .env file with your specific configuration

# 3. Never commit .env to version control

# 4. For production, ensure all security-sensitive values are properly set

# 5. Use environment-specific .env files:
#    - .env.development for development
#    - .env.staging for staging
#    - .env.production for production

# 6. Restart containers after changing environment variables:
#    docker-compose down && docker-compose up -d

# ===========================================================================
# Troubleshooting
# ===========================================================================

# If database connection fails:
# - Verify DATABASE_URL format
# - Ensure database service is running

# If AWS integration fails:
# - Verify AWS credentials
# - Check AWS region
# - Ensure IAM permissions are correct

# If frontend cannot connect to backend:
# - Check VITE_API_BASE_URL
# - Verify backend service is running
# - Check CORS configuration

# For more help, see README.md


{
  "name": "complianceguard-frontend",
  "version": "3.9.0",
  "private": true,
  "description": "ComplianceGuard SOC 2 Automation Platform Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node ../scripts/generate-evidence-catalog.mjs",
    "build": "tsc && vite build",
    "prebuild": "node ../scripts/generate-evidence-catalog.mjs",
    "preview": "vite preview",
    "generate:evidence": "node ../scripts/generate-evidence-catalog.mjs",
    "check:evidence": "node ../scripts/generate-evidence-catalog.mjs --check",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@mui/icons-material": "^9.0.0",
    "@mui/lab": "^9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@sentry/react": "^10.48.0",
    "@tanstack/react-query": "^5.8.0",
    "axios": "^1.6.0",
    "framer-motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "jsdom": "^22.1.0",
    "js-yaml": "^5.4.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}

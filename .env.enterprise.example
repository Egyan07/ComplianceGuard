# ComplianceGuard Enterprise — Environment Configuration
# Copy to .env and fill in all values before running enterprise-install.sh

# Application version to deploy (must match image tarballs in the bundle)
APP_VERSION=3.2.0

# Database credentials — use a strong, unique password
POSTGRES_DB=complianceguard
POSTGRES_USER=cguser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Secret key for JWT signing — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_32_BYTE_HEX_SECRET_HERE


# TLS certificate and key paths on the host machine
TLS_CERT_PATH=/etc/complianceguard/certs/cert.pem
TLS_KEY_PATH=/etc/complianceguard/certs/key.pem

# HTTPS port (default 443)
HTTPS_PORT=443

# CORS allowed origins — set to your internal domain
CORS_ORIGINS=https://compliance.yourcompany.internal
